{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Data.Pages }}
  {{- $priority := 0.5 -}}
  {{- $changefreq := "monthly" -}}

  {{/* Home page gets top priority and a weekly refresh signal. */}}
  {{- if .IsHome -}}
    {{- $priority = 1.0 -}}
    {{- $changefreq = "weekly" -}}
  {{- end -}}

  {{/* Posts marked `pillar: true` in front-matter are evergreen flagship pieces. */}}
  {{- if .Params.pillar -}}
    {{- $priority = 1.0 -}}
    {{- $changefreq = "monthly" -}}
  {{- else if eq .Section "posts" -}}
    {{/* Recent posts get a higher priority than stale ones. */}}
    {{- $ageDays := div (sub now.Unix .Date.Unix) 86400 -}}
    {{- if lt $ageDays 30 -}}
      {{- $priority = 0.9 -}}
      {{- $changefreq = "weekly" -}}
    {{- else if lt $ageDays 180 -}}
      {{- $priority = 0.8 -}}
      {{- $changefreq = "monthly" -}}
    {{- else -}}
      {{- $priority = 0.6 -}}
      {{- $changefreq = "yearly" -}}
    {{- end -}}
  {{- else if eq .Section "tn-2026-results" -}}
    {{/* Constituency result pages: final data, low churn. Section hub ranks above leaves. */}}
    {{- if .IsSection -}}
      {{- $priority = 0.7 -}}
      {{- $changefreq = "monthly" -}}
    {{- else -}}
      {{- $priority = 0.6 -}}
      {{- $changefreq = "yearly" -}}
    {{- end -}}
  {{- end -}}

  {{/* Per-page override via `sitemap.priority` / `sitemap.changefreq` frontmatter. */}}
  {{- with .Sitemap.Priority -}}{{- $priority = . -}}{{- end -}}
  {{- with .Sitemap.ChangeFreq -}}{{- $changefreq = . -}}{{- end }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}
    <changefreq>{{ $changefreq }}</changefreq>
    <priority>{{ $priority }}</priority>
    {{ if .IsTranslated }}{{ range .Translations }}
    <xhtml:link rel="alternate" hreflang="{{ .Lang }}" href="{{ .Permalink }}" />{{ end }}
    <xhtml:link rel="alternate" hreflang="{{ .Lang }}" href="{{ .Permalink }}" />{{ end }}
  </url>
  {{ end }}
</urlset>
